-- ============================================================
-- Migration v8d — Fix RLS policies for all logistics tables
-- Uses SEPARATE SELECT/INSERT/UPDATE/DELETE policies instead
-- of a single FOR ALL, which can fail on INSERT in Supabase.
-- Run in Supabase SQL Editor. Safe to re-run.
-- ============================================================

-- ────────────────────────────────────────────────────────────
-- Helper: make sure the authenticated role has privileges
-- ────────────────────────────────────────────────────────────
GRANT USAGE ON SCHEMA public TO authenticated, anon;

GRANT ALL ON courier_invoices       TO authenticated;
GRANT ALL ON awbs                   TO authenticated;
GRANT ALL ON awb_allocations        TO authenticated;
GRANT ALL ON markup_rules           TO authenticated;
GRANT ALL ON supplier_invoices      TO authenticated;
GRANT ALL ON supplier_invoice_lines TO authenticated;

-- Sequences (needed for uuid_generate_v4 via default value)
GRANT USAGE, SELECT ON ALL SEQUENCES IN SCHEMA public TO authenticated;

-- ────────────────────────────────────────────────────────────
-- courier_invoices
-- ────────────────────────────────────────────────────────────
DROP POLICY IF EXISTS "Users can CRUD own courier_invoices"          ON courier_invoices;
DROP POLICY IF EXISTS "Household members can access courier_invoices" ON courier_invoices;
DROP POLICY IF EXISTS "ci_select"  ON courier_invoices;
DROP POLICY IF EXISTS "ci_insert"  ON courier_invoices;
DROP POLICY IF EXISTS "ci_update"  ON courier_invoices;
DROP POLICY IF EXISTS "ci_delete"  ON courier_invoices;

CREATE POLICY "ci_select" ON courier_invoices
  FOR SELECT TO authenticated
  USING (auth.uid() = user_id);

CREATE POLICY "ci_insert" ON courier_invoices
  FOR INSERT TO authenticated
  WITH CHECK (auth.uid() = user_id);

CREATE POLICY "ci_update" ON courier_invoices
  FOR UPDATE TO authenticated
  USING  (auth.uid() = user_id)
  WITH CHECK (auth.uid() = user_id);

CREATE POLICY "ci_delete" ON courier_invoices
  FOR DELETE TO authenticated
  USING (auth.uid() = user_id);

-- ────────────────────────────────────────────────────────────
-- awbs
-- ────────────────────────────────────────────────────────────
DROP POLICY IF EXISTS "Users can CRUD own awbs" ON awbs;
DROP POLICY IF EXISTS "awb_select" ON awbs;
DROP POLICY IF EXISTS "awb_insert" ON awbs;
DROP POLICY IF EXISTS "awb_update" ON awbs;
DROP POLICY IF EXISTS "awb_delete" ON awbs;

CREATE POLICY "awb_select" ON awbs
  FOR SELECT TO authenticated
  USING (auth.uid() = user_id);

CREATE POLICY "awb_insert" ON awbs
  FOR INSERT TO authenticated
  WITH CHECK (auth.uid() = user_id);

CREATE POLICY "awb_update" ON awbs
  FOR UPDATE TO authenticated
  USING  (auth.uid() = user_id)
  WITH CHECK (auth.uid() = user_id);

CREATE POLICY "awb_delete" ON awbs
  FOR DELETE TO authenticated
  USING (auth.uid() = user_id);

