-- ────────────────────────────────────────────────────────────
-- supplier_invoices
-- ────────────────────────────────────────────────────────────
DROP POLICY IF EXISTS "Users can CRUD own supplier_invoices"          ON supplier_invoices;
DROP POLICY IF EXISTS "Household members can access supplier_invoices" ON supplier_invoices;
DROP POLICY IF EXISTS "si_select" ON supplier_invoices;
DROP POLICY IF EXISTS "si_insert" ON supplier_invoices;
DROP POLICY IF EXISTS "si_update" ON supplier_invoices;
DROP POLICY IF EXISTS "si_delete" ON supplier_invoices;

CREATE POLICY "si_select" ON supplier_invoices
  FOR SELECT TO authenticated
  USING (auth.uid() = user_id);

CREATE POLICY "si_insert" ON supplier_invoices
  FOR INSERT TO authenticated
  WITH CHECK (auth.uid() = user_id);

CREATE POLICY "si_update" ON supplier_invoices
  FOR UPDATE TO authenticated
  USING  (auth.uid() = user_id)
  WITH CHECK (auth.uid() = user_id);

CREATE POLICY "si_delete" ON supplier_invoices
  FOR DELETE TO authenticated
  USING (auth.uid() = user_id);

-- ────────────────────────────────────────────────────────────
-- supplier_invoice_lines  (access via parent invoice)
-- ────────────────────────────────────────────────────────────
DROP POLICY IF EXISTS "Users can CRUD own supplier_invoice_lines" ON supplier_invoice_lines;
DROP POLICY IF EXISTS "sil_select" ON supplier_invoice_lines;
DROP POLICY IF EXISTS "sil_insert" ON supplier_invoice_lines;
DROP POLICY IF EXISTS "sil_update" ON supplier_invoice_lines;
DROP POLICY IF EXISTS "sil_delete" ON supplier_invoice_lines;

CREATE POLICY "sil_select" ON supplier_invoice_lines
  FOR SELECT TO authenticated
  USING (
    supplier_invoice_id IN (
      SELECT id FROM supplier_invoices WHERE user_id = auth.uid()
    )
  );

CREATE POLICY "sil_insert" ON supplier_invoice_lines
  FOR INSERT TO authenticated
  WITH CHECK (
    supplier_invoice_id IN (
      SELECT id FROM supplier_invoices WHERE user_id = auth.uid()
    )
  );

CREATE POLICY "sil_update" ON supplier_invoice_lines
  FOR UPDATE TO authenticated
  USING (
    supplier_invoice_id IN (
      SELECT id FROM supplier_invoices WHERE user_id = auth.uid()
    )
  )
  WITH CHECK (
    supplier_invoice_id IN (
      SELECT id FROM supplier_invoices WHERE user_id = auth.uid()
    )
  );

CREATE POLICY "sil_delete" ON supplier_invoice_lines
  FOR DELETE TO authenticated
  USING (
    supplier_invoice_id IN (
      SELECT id FROM supplier_invoices WHERE user_id = auth.uid()
    )
  );

