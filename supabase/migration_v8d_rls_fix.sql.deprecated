DROP POLICY IF EXISTS "mr_select" ON markup_rules;
DROP POLICY IF EXISTS "mr_insert" ON markup_rules;
DROP POLICY IF EXISTS "mr_update" ON markup_rules;
DROP POLICY IF EXISTS "mr_delete" ON markup_rules;

