import { createServerClient } from '@supabase/ssr'
import { NextResponse, type NextRequest } from 'next/server'
import type { CookieOptions } from '@supabase/ssr'
import { isPortalPath } from '@/lib/chit/portalPath'

// Next.js 16 calls this file "proxy" (it used to be "middleware"). There can
// only be one of them, so everything that has to look at the request before a
// page renders lives here.
//
// Two jobs:
//   1. Keep the Supabase session fresh and bounce signed-out people to /login.
//   2. Put the current path into a request header.
//
// Job 2 is for chit-only staff (v120). Staff must not land on Payroll or
// Investments. That decision needs the database — it depends on a grant row —
// so it belongs in the app layout, which already queries. But a Server
// Component layout is not told which URL it is rendering, and guessing is not
// good enough for an access rule. So the path is passed along as a header and
// the layout decides.
//
// Nothing here can fail open: if the header were ever missing, the layout sees
// no path, and the database still refuses every non-chit row to a staff
// session.

export const PATHNAME_HEADER = 'x-pathname'



function withPathname(request: NextRequest): Headers {
  const headers = new Headers(request.headers)
  headers.set(PATHNAME_HEADER, request.nextUrl.pathname)
  return headers
}

export async function proxy(request: NextRequest) {
  let supabaseResponse = NextResponse.next({
    request: { headers: withPathname(request) },
  })

  const supabase = createServerClient(
    process.env.NEXT_PUBLIC_SUPABASE_URL!,
    process.env.NEXT_PUBLIC_SUPABASE_ANON_KEY!,
    {
      cookies: {
        getAll() {
          return request.cookies.getAll()
        },
        setAll(cookiesToSet: { name: string; value: string; options: CookieOptions }[]) {
          cookiesToSet.forEach(({ name, value }) => request.cookies.set(name, value))
          supabaseResponse = NextResponse.next({
            request: { headers: withPathname(request) },
          })
          cookiesToSet.forEach(({ name, value, options }) =>
            supabaseResponse.cookies.set(name, value, options)
          )
        },
      },
    }
  )

  const {
    data: { user },
  } = await supabase.auth.getUser()

  const isAuthPage = request.nextUrl.pathname.startsWith('/login') ||
    request.nextUrl.pathname.startsWith('/signup')

  // The chit member portal lives under /m and has its own login (a one-time
  // link, then a PIN). Its visitors are members, not Inex users, so they have
  // no Supabase session and must never be sent to /login. The matcher below
  // already skips /m; this is the second lock on the same door.
  if (isPortalPath(request.nextUrl.pathname)) {
    return supabaseResponse
  }

  if (!user && !isAuthPage && request.nextUrl.pathname !== '/') {
    const url = request.nextUrl.clone()
    url.pathname = '/login'
    return NextResponse.redirect(url)
  }

  if (user && isAuthPage) {
    const url = request.nextUrl.clone()
    url.pathname = '/dashboard'
    return NextResponse.redirect(url)
  }

  return supabaseResponse
}

export const config = {
  // Exclude /api so route handlers (crons, exchange-rates, webhooks) run
  // without a user session and aren't redirected to /login.
  // Exclude /m, the chit member portal: its visitors are members with their
  // own PIN login, not Inex users, and sending them to /login is the bug they
  // kept hitting. Also skip static.
  matcher: [
    '/((?!api|m$|m/|_next/static|_next/image|favicon.ico|.*\\.(?:svg|png|jpg|jpeg|gif|webp)$).*)',
  ],
}
